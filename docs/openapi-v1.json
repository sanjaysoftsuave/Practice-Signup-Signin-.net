{
    "openapi": "3.1.1",
    "info": {
        "title": "EmployeeApp.Api | v1",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:5286/"
        }
    ],
    "paths": {
        "/api/auth/signup": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Creates a new account with the \"User\" role (read-only access to employees).",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CredentialsRequest"
                            }
                        },
                        "application/*+json": {
                            "schema": {
                                "$ref": "#/components/schemas/CredentialsRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created. The body has the account, without the password.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid email, or the password is too weak.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationProblemDetails"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "An account with this email already exists.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Checks the email and password, and returns a JWT to send as \"Authorization: Bearer &lt;token&gt;\".",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CredentialsRequest"
                            }
                        },
                        "application/*+json": {
                            "schema": {
                                "$ref": "#/components/schemas/CredentialsRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "The access token and when it expires.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The body is invalid (e.g. no email).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationProblemDetails"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Wrong email or password. The message doesn't say which, on purpose.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Shows who the token belongs to. Needs a valid token: no token or an expired one gives 401.",
                "responses": {
                    "200": {
                        "description": "The claims read from the token.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CurrentUserResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No token, or the token is invalid or expired.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/employees": {
            "get": {
                "tags": [
                    "Employees"
                ],
                "summary": "Lists all employees, or only one department's employees.",
                "parameters": [
                    {
                        "name": "department",
                        "in": "query",
                        "description": "Optional department code filter, e.g. ENG.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "The employees, ordered by Id.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/EmployeeResponse"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The department code doesn't exist.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Employees"
                ],
                "summary": "Hires a new employee. The server assigns the Id.",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmployeeRequest"
                            }
                        },
                        "application/*+json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmployeeRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "Created. The Location header holds the new employee's URL.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EmployeeResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The body is invalid, or it breaks a business rule\r\n    (unknown department or manager, intern salary over the cap).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/employees/{id}": {
            "get": {
                "tags": [
                    "Employees"
                ],
                "summary": "Gets one employee by Id.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "The employee.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EmployeeResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No employee has this Id.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Employees"
                ],
                "summary": "Replaces an employee completely. Fields you leave out go back to their defaults.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmployeeRequest"
                            }
                        },
                        "application/*+json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmployeeRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "Updated. No body.",
                        "content": {
                            "application/json": {}
                        }
                    },
                    "400": {
                        "description": "The body is invalid, or it breaks a business rule.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationProblemDetails"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No employee has this Id.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Employees"
                ],
                "summary": "Removes an employee.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": "integer",
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "Deleted. No body.",
                        "content": {
                            "application/json": {}
                        }
                    },
                    "404": {
                        "description": "No employee has this Id.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Other employees still report to this person.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CredentialsRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "type": "object",
                "properties": {
                    "email": {
                        "examples": [
                            "priya@example.com"
                        ],
                        "maxLength": 200,
                        "minLength": 0,
                        "type": "string"
                    },
                    "password": {
                        "examples": [
                            "Secret123"
                        ],
                        "maxLength": 100,
                        "minLength": 8,
                        "type": "string",
                        "description": "At least 8 characters, with at least one letter and one digit."
                    }
                },
                "description": "Body of POST /api/auth/signup and POST /api/auth/login."
            },
            "CurrentUserResponse": {
                "required": [
                    "id",
                    "email",
                    "roles"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "email": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "description": "What GET /api/auth/me reads back from the token's claims."
            },
            "EmployeeRequest": {
                "required": [
                    "name",
                    "departmentCode"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "examples": [
                            "Divya"
                        ],
                        "maxLength": 100,
                        "minLength": 0,
                        "type": "string"
                    },
                    "departmentCode": {
                        "examples": [
                            "ENG"
                        ],
                        "maxLength": 10,
                        "minLength": 0,
                        "type": "string",
                        "description": "Department code, e.g. ENG, HR or SALES (case doesn't matter)."
                    },
                    "monthlySalary": {
                        "examples": [
                            85000
                        ],
                        "maximum": 10000000,
                        "minimum": 0,
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                        "type": [
                            "number",
                            "string"
                        ],
                        "format": "double"
                    },
                    "role": {
                        "$ref": "#/components/schemas/EmployeeRole"
                    },
                    "email": {
                        "examples": [
                            "divya@example.com"
                        ],
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "managerId": {
                        "examples": [
                            1
                        ],
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "description": "Id of this employee's manager. Leave out (null) for no manager.",
                        "format": "int32"
                    },
                    "location": {
                        "$ref": "#/components/schemas/WorkLocationType"
                    }
                },
                "description": "Body for POST (create) and PUT (replace). There's no Id here: the URL carries it for PUT,\r\nand the server generates it for POST.\r\n6.4 The attributes are checked automatically by [ApiController] BEFORE the action runs;\r\na failure returns 400 with the list of errors (Day 8 goes deeper into validation)."
            },
            "EmployeeResponse": {
                "required": [
                    "id",
                    "name",
                    "role",
                    "departmentCode",
                    "email",
                    "managerId",
                    "location",
                    "monthlySalary",
                    "monthlyPay",
                    "bonus",
                    "joinedOn"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "name": {
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/EmployeeRole"
                    },
                    "departmentCode": {
                        "type": "string"
                    },
                    "email": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "managerId": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "location": {
                        "$ref": "#/components/schemas/WorkLocationType"
                    },
                    "monthlySalary": {
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                        "type": [
                            "number",
                            "string"
                        ],
                        "format": "double"
                    },
                    "monthlyPay": {
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                        "type": [
                            "number",
                            "string"
                        ],
                        "format": "double"
                    },
                    "bonus": {
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                        "type": [
                            "number",
                            "string"
                        ],
                        "format": "double"
                    },
                    "joinedOn": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "description": "What the API returns for one employee. 2.5 A record: read-only data, no behaviour.\r\nMonthlyPay and Bonus are calculated by the Core rules; the client can't send them."
            },
            "EmployeeRole": {
                "type": "integer",
                "description": "Kind of employee. Sent and returned as a string: \"FullTime\", \"Manager\" or \"Intern\"."
            },
            "ProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "status": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "detail": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "instance": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "TokenResponse": {
                "required": [
                    "accessToken",
                    "tokenType",
                    "expiresAt"
                ],
                "type": "object",
                "properties": {
                    "accessToken": {
                        "type": "string"
                    },
                    "tokenType": {
                        "type": "string"
                    },
                    "expiresAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "description": "The token sent back after a successful login."
            },
            "UserResponse": {
                "required": [
                    "id",
                    "email",
                    "role",
                    "createdOn"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "email": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string"
                    },
                    "createdOn": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "description": "An account, as the API shows it. There is no password or hash here, ever."
            },
            "ValidationProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "status": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "detail": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "instance": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "WorkLocationType": {
                "type": "integer",
                "description": "Where the employee works: \"Office\", \"Remote\" or \"Hybrid\"."
            }
        },
        "securitySchemes": {
            "Bearer": {
                "type": "http",
                "description": "Paste the accessToken from POST /api/auth/login (without the word Bearer).",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "security": [
        {
            "Bearer": []
        }
    ],
    "tags": [
        {
            "name": "Auth"
        },
        {
            "name": "Employees"
        }
    ]
}
