{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Empty = the API keeps its data in memory.
  // Set the real value with user-secrets (never in this file, because it holds a password):
  //   dotnet user-secrets set "ConnectionStrings:EmployeeDb" "Host=localhost;Port=5432;Database=employeeapp;Username=postgres;Password=..." --project src/EmployeeApp.Api
  "ConnectionStrings": {
    "EmployeeDb": ""
  },
  // 10.2 JWT settings. Key is EMPTY on purpose: it is a secret, so set it with user-secrets
  // (at least 32 random characters). The app refuses to start without it.
  //   dotnet user-secrets set "Jwt:Key" "<32+ random characters>" --project src/EmployeeApp.Api
  "Jwt": {
    "Issuer": "EmployeeApp.Api",
    "Audience": "EmployeeApp.Clients",
    "ExpiryMinutes": 60,
    "Key": ""
  },
  // 10.3 The one Admin account is created at startup. Its password is a secret too:
  //   dotnet user-secrets set "Auth:AdminPassword" "<a strong password>" --project src/EmployeeApp.Api
  "Auth": {
    "AdminEmail": "admin@employeeapp.local"
  }
}
